# Copy this file to deploy/aws/aws-account.env and edit the values.
# This file selects credentials already stored by the AWS CLI; do not put access keys here.

# The AWS CLI profile created by `aws configure sso --profile ecommerce`
# or `aws configure --profile ecommerce`.
AWS_PROFILE=ecommerce

# The 12-digit account ID shown by the AWS Console or `aws sts get-caller-identity`.
AWS_ACCOUNT_ID=123456789012

# The region for EC2 and the data services. CloudFront/WAF also uses us-east-1 automatically.
AWS_REGION=us-east-2

# Set to true for an AWS IAM Identity Center/SSO profile. Set to false for other profiles.
AWS_SSO_LOGIN=true
