# Copy to .env for local use. These are development-only credentials.
MYSQL_IMAGE=mysql:8.4.11
REDIS_IMAGE=redis:8.2.10
KAFKA_IMAGE=apache/kafka:4.3.1
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.4.5
CONSUL_IMAGE=hashicorp/consul:1.22.7
FLYWAY_IMAGE=flyway/flyway:13.6.0-alpine
MAVEN_IMAGE=maven:3.9.11-eclipse-temurin-21-alpine
JAVA_RUNTIME_IMAGE=eclipse-temurin:21.0.8_9-jre-alpine
NODE_IMAGE=node:24.11.0-alpine
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.2-alpine
SWAGGER_UI_IMAGE=swaggerapi/swagger-ui:v5.33.1

MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_APP_USER=ecommerce
MYSQL_APP_PASSWORD=local-app-password

MYSQL_CORE_PORT=13306
MYSQL_ORDER_0_PORT=13307
MYSQL_ORDER_1_PORT=13308
REDIS_PORT=6379
KAFKA_PORT=9092
ELASTICSEARCH_PORT=9200
CONSUL_HTTP_PORT=8500
GATEWAY_PORT=8080
CATALOG_PORT=8081
INVENTORY_PORT=8082
ORDER_PORT=8083
STOREFRONT_PORT=8084
SWAGGER_UI_PORT=8085

# Stable ID for the single-node local KRaft cluster. Never reuse for another cluster.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
